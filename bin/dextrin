#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * `dextrin` CLI -- one executable, six subcommands (`decode`,
 * `encode`, `format`, `validate`, `compat`, `conformance`), the PHP analog of both the JS
 * port's `bin/dextrin.js` and `dextrin`'s own `mix dextrin.*` tasks.
 * One bin with subcommands rather than a separate script per task,
 * matching how CLIs are conventionally shaped (`git <subcommand>`),
 * not a mechanical per-file port of the Mix task layout.
 *
 * Two Mix tasks have no analog here, deliberately, for the same
 * reasons the JS port omits them:
 *   - `mix dextrin.gen.unicode` regenerates a generated grammar's
 *     Unicode identifier ranges from UCD data -- this port's lexer
 *     uses PCRE's own `\p{L}`/similar Unicode property escapes
 *     directly instead, so there is no generated-ranges file to
 *     regenerate.
 *   - `mix dextrin.gen.schema` scaffolds a `.dxns` file from an
 *     existing Elixir struct via `Map.from_struct/1` reflection -- a
 *     PHP class has no built-in field-reflection-to-schema mechanism
 *     to scaffold from either (though `get_object_vars()` could in
 *     principle drive one; not built, matching the JS port's own
 *     scope decision here).
 *
 * `mix dextrin.encode`'s `--share` flag also has no analog: the
 * `.dxnb` encoder doesn't produce `dxn/DXN.md` §2.5 value-sharing
 * output yet (decode-only for now, see `src/Binary/Encoder.php`'s own
 * note).
 */

require __DIR__ . '/../vendor/autoload.php';

use JOetjen\Dextrin\Dextrin;
use JOetjen\Dextrin\DXNError;
use JOetjen\Dextrin\Registry;
use JOetjen\Dextrin\Schema;

const USAGE = <<<'USAGE'
    usage: dextrin <command> [options]

    Commands:
      decode PATH [--out PATH]                    Decode .dxnb binary to .dxn text (pretty-printed)
      encode PATH [--out PATH]                     Encode .dxn text to .dxnb binary
      format PATH [--mode pretty|condense] [--in-place]
                                                    Reformat a .dxn file
      validate PATH [--format text|binary] [--schema PATH --as NAME]
                                                    Validate a .dxn/.dxnb file, optionally against a schema
      compat OLD NEW                               Check that changed schemas have new versions (each a .dxns file or directory)
      check SCHEMAS... [--extern NAMESPACE]... [--warnings-as-errors]
                                                    Check a tree of .dxns schemas: syntax, compiling, layout and names
      docs SCHEMAS [--out DIR] [--title TITLE]     Write HTML documentation for a directory of .dxns schemas
      from-json-schema SCHEMA... [--out FILE] [--name N] [--schemas DIR] [--draft D] [--mongo] [--structs] [--assert-formats] [--strict]
                                                    Convert JSON Schema (drafts 04 to 2020-12, MongoDB's $jsonSchema) to DXNS
      from-typespec MAIN.tsp [--out DIR]            Convert TypeSpec to DXNS with the @joetjen/dextrin-typespec emitter (Node 22, npx)
      conformance REQUEST ANSWER                   Answer a Dextrin Conformance Suite request

    Run with no PATH, or an unrecognized command, to see this message.
    USAGE;

/** @param list<string> $argv */
function main(array $argv): int
{
    $command = $argv[0] ?? null;
    $rest = array_slice($argv, 1);
    return match ($command) {
        'decode' => run(static fn () => cmdDecode($rest)),
        'encode' => run(static fn () => cmdEncode($rest)),
        'format' => run(static fn () => cmdFormat($rest)),
        'validate' => run(static fn () => cmdValidate($rest)),
        'compat' => run(static fn () => cmdCompat($rest)),
        'docs' => run(static fn () => cmdDocs($rest)),
        'check' => run(static fn () => cmdCheck($rest)),
        'from-json-schema' => run(static fn () => cmdFromJsonSchema($rest)),
        'from-typespec' => run(static fn () => cmdFromTypespec($rest)),
        'conformance' => run(static fn () => cmdConformance($rest)),
        default => printUsageAndExit($command),
    };
}

/**
 * `dextrin docs SCHEMAS [--out DIR] [--title TITLE]`: every `.dxns` file
 * under `SCHEMAS` as HTML documentation in `DIR` (`doc/schemas` when not
 * given), as `mix dextrin.docs` writes it.
 *
 * @param list<string> $argv
 */
function cmdDocs(array $argv): void
{
    ['positional' => $positional, 'options' => $options] = parseArgs($argv, optionNames: ['out', 'title']);
    if (count($positional) !== 1) {
        throw new \RuntimeException('usage: dextrin docs SCHEMAS [--out DIR] [--title TITLE]');
    }
    $out = $options['out'] ?? 'doc/schemas';
    $written = \JOetjen\Dextrin\Schema\Docs::write($positional[0], $out, $options['title'] ?? null);
    fwrite(STDOUT, 'wrote ' . count($written) . " files to {$out}\n");
}

/**
 * `dextrin check SCHEMAS... [--extern NAMESPACE]... [--warnings-as-errors]`:
 * a tree of `.dxns` schemas checked as `mix dextrin.check` checks it --
 * every problem printed as `file:line: message`, and a non-zero exit.
 *
 * A schema that uses something deprecated (DXNS.md §1b) is a warning,
 * printed as `warning: ...`; the check still passes, unless
 * `--warnings-as-errors` is given.
 *
 * @param list<string> $argv
 */
function cmdCheck(array $argv): void
{
    $roots = [];
    $extern = [];
    $warningsAsErrors = false;
    for ($i = 0; $i < count($argv); $i++) {
        if ($argv[$i] === '--extern') {
            $extern[] = $argv[++$i] ?? '';
        } elseif ($argv[$i] === '--warnings-as-errors') {
            $warningsAsErrors = true;
        } else {
            $roots[] = $argv[$i];
        }
    }
    if ($roots === []) {
        throw new \RuntimeException('usage: dextrin check SCHEMAS... [--extern NAMESPACE]... [--warnings-as-errors]');
    }
    $result = \JOetjen\Dextrin\Schema\Tree::load($roots, $extern);
    if ($result['ok']) {
        $warnings = $result['registry']->warnings();
        foreach ($warnings as $warning) {
            fwrite(STDOUT, 'warning: ' . \JOetjen\Dextrin\Schema\Deprecations::text($warning) . "\n");
        }
        if ($warningsAsErrors && $warnings !== []) {
            throw new \RuntimeException(count($warnings) . ' warning(s), and --warnings-as-errors');
        }
        fwrite(STDOUT, "OK: {$result['summary']['files']} files, {$result['summary']['definitions']} definitions\n");
        return;
    }
    foreach ($result['problems'] as $p) {
        fwrite(STDERR, "{$p['file']}:{$p['line']}: {$p['message']}\n");
    }
    throw new \RuntimeException(count($result['problems']) . ' problem(s)');
}

/**
 * `dextrin from-json-schema SCHEMA... [options]`: JSON Schema to DXNS
 * ({@see \JOetjen\Dextrin\Convert\JsonSchema}), as `mix
 * dextrin.from_json_schema` converts it -- drafts 04, 06, 07, 2019-09 and
 * 2020-12, and MongoDB's `$jsonSchema` with `bsonType`.
 *
 * The first file is the root. A `$ref` to another document is resolved
 * among the files given and every `.json` file under `--schemas DIR`, by
 * `$id` or by relative path; nothing is fetched. `--out FILE` writes the
 * DXNS there instead of to standard output; `--name` names the root
 * (otherwise its `title`, otherwise `Root`); `--draft` reads a schema with
 * no `$schema` (default 2020-12); `--mongo` reads it as MongoDB's (also
 * when `bsonType` appears); `--structs` writes named object schemas as
 * `%schema`; `--assert-formats` checks `format` and the content keywords
 * in 2019-09 and 2020-12 too. Whatever is not exact is printed to
 * standard error as `inexact: PATH: why`; `--strict` fails on it.
 *
 * @param list<string> $argv
 */
function cmdFromJsonSchema(array $argv): void
{
    ['positional' => $files, 'flags' => $flags, 'options' => $options] = parseArgs(
        $argv,
        ['mongo', 'structs', 'assert-formats', 'strict'],
        ['out', 'name', 'draft', 'schemas'],
    );
    if ($files === []) {
        throw new \RuntimeException('usage: dextrin from-json-schema SCHEMA... [--out FILE] [options]');
    }
    $paths = $files;
    if (isset($options['schemas'])) {
        $under = [];
        $walk = new \RecursiveIteratorIterator(new \RecursiveDirectoryIterator($options['schemas'], \FilesystemIterator::SKIP_DOTS));
        foreach ($walk as $file) {
            if ($file instanceof \SplFileInfo && $file->isFile() && str_ends_with($file->getFilename(), '.json')) {
                $under[] = rtrim($options['schemas'], '/') . '/' . substr($file->getPathname(), strlen(rtrim($options['schemas'], '/')) + 1);
            }
        }
        sort($under, SORT_STRING);
        $paths = [...$paths, ...array_values(array_filter($under, static fn (string $p): bool => !in_array($p, $files, true)))];
    }
    $sources = array_map(static fn (string $path): array => [$path, readFileContents($path)], $paths);
    ['document' => $document, 'inexact' => $inexact] = \JOetjen\Dextrin\Convert\JsonSchema::toDxns($sources, array_filter([
        'name' => $options['name'] ?? null,
        'draft' => $options['draft'] ?? null,
        'mongo' => $flags['mongo'] ?? false,
        'structs' => $flags['structs'] ?? false,
        'assertFormats' => $flags['assert-formats'] ?? false,
    ], static fn (mixed $v): bool => $v !== null));
    foreach ($inexact as $place) {
        fwrite(STDERR, "inexact: {$place['path']}: {$place['why']}\n");
    }
    if (($flags['strict'] ?? false) && $inexact !== []) {
        throw new \RuntimeException(count($inexact) . ' place(s) not exact, and --strict');
    }
    $text = Dextrin::encode($document, pretty: true) . "\n";
    if (isset($options['out'])) {
        file_put_contents($options['out'], $text);
        fwrite(STDOUT, "wrote {$options['out']}\n");
    } else {
        fwrite(STDOUT, $text);
    }
}

/**
 * `dextrin from-typespec MAIN.tsp [--out DIR]`: TypeSpec to DXNS, as `mix
 * dextrin.from_typespec` converts it -- TypeSpec's own compiler, run
 * through npx with the `@joetjen/dextrin-typespec` emitter, which writes
 * one `.dxns` file per namespace, and per schema version in a versioned
 * namespace, into `DIR` (default `schemas`). It needs Node 22 or later,
 * `npx`, and the emitter installed where the TypeSpec project is.
 *
 * @param list<string> $argv
 */
function cmdFromTypespec(array $argv): void
{
    ['positional' => $files, 'options' => $options] = parseArgs($argv, optionNames: ['out']);
    if (count($files) !== 1) {
        throw new \RuntimeException('usage: dextrin from-typespec MAIN.tsp [--out DIR]');
    }
    $emitter = '@joetjen/dextrin-typespec';
    $out = absolutePath($options['out'] ?? 'schemas');
    $npx = onPath('npx') ?? throw new \RuntimeException('npx was not found: TypeSpec needs Node 22 or later, with npx on the PATH');
    $process = proc_open(
        [$npx, '--no-install', 'tsp', 'compile', $files[0], '--emit', $emitter, '--option', "{$emitter}.emitter-output-dir={$out}"],
        [1 => STDOUT, 2 => STDERR],
        $pipes,
    );
    if ($process === false) {
        throw new \RuntimeException('npx was not found: TypeSpec needs Node 22 or later, with npx on the PATH');
    }
    $status = proc_close($process);
    if ($status !== 0) {
        throw new \RuntimeException("tsp compile failed (exit {$status})");
    }
    fwrite(STDOUT, "wrote {$out}\n");
}

/** The executable `$name` in a directory of the PATH, or `null`. */
function onPath(string $name): ?string
{
    foreach (explode(PATH_SEPARATOR, (string) getenv('PATH')) as $dir) {
        $candidate = rtrim($dir === '' ? '.' : $dir, '/') . '/' . $name;
        if (is_file($candidate) && is_executable($candidate)) {
            return $candidate;
        }
    }
    return null;
}

/** `$path` made absolute against the working directory, its `.` and `..` resolved. */
function absolutePath(string $path): string
{
    $full = str_starts_with($path, '/') ? $path : getcwd() . '/' . $path;
    $segments = [];
    foreach (explode('/', $full) as $segment) {
        if ($segment === '' || $segment === '.') {
            continue;
        }
        if ($segment === '..') {
            array_pop($segments);
            continue;
        }
        $segments[] = $segment;
    }
    return '/' . implode('/', $segments);
}

/**
 * `dextrin compat OLD NEW` -- the version discipline check
 * (`Schema::compat`, DXNS.md §8), for CI against the previous release's
 * schema files. Lists what the latest versions' materializers have to
 * upgrade; a version whose content changed without a new version, or a
 * version that went down, is reported and exits non-zero -- of a schema
 * or of a named type with versions (`%type(N)`, DXNS.md §5c).
 *
 * @param list<string> $args
 */
function cmdCompat(array $args): void
{
    if (count($args) !== 2) {
        throw new \RuntimeException('usage: dextrin compat OLD NEW (each a .dxns file or a directory)');
    }
    ['problems' => $problems, 'upgrades' => $upgrades] = Schema::compat(loadedSchemas($args[0]), loadedSchemas($args[1]));
    foreach ($upgrades as $upgrade) {
        $changes = [];
        foreach (['added', 'removed', 'changed'] as $what) {
            if ($upgrade[$what] !== []) {
                $changes[] = $what . ' ' . implode(', ', $upgrade[$what]);
            }
        }
        $listed = $changes === [] ? 'no field changes' : implode('; ', $changes);
        fwrite(STDOUT, "{$upgrade['schema']} {$upgrade['from']} -> {$upgrade['to']}: {$listed}\n");
    }
    if ($problems !== []) {
        // A named type's versions (`%type(N)`, DXNS.md §5c) under `type`.
        throw new \RuntimeException(implode("\n", array_map(
            static function (array $p): string {
                $what = isset($p['type']) ? "named type {$p['type']}" : $p['schema'];
                return $p['problem'] === 'version-went-down'
                    ? "{$what} went down from version {$p['from']} to {$p['to']}"
                    : "{$what} version {$p['version']} changed without a new version";
            },
            $problems,
        )));
    }
    fwrite(STDOUT, "OK: no version discipline problems\n");
}

/**
 * Every `.dxns` document under `$path` (or `$path` itself, a file),
 * compiled into one registry -- so several versions of a schema, each in
 * its own document, sit side by side.
 */
function loadedSchemas(string $path): Registry
{
    $files = [$path];
    if (is_dir($path)) {
        $files = [];
        $found = new \RecursiveIteratorIterator(new \RecursiveDirectoryIterator($path, \FilesystemIterator::SKIP_DOTS));
        foreach ($found as $file) {
            if ($file instanceof \SplFileInfo && str_ends_with($file->getPathname(), '.dxns')) {
                $files[] = $file->getPathname();
            }
        }
        sort($files);
    }
    $registry = new Registry();
    foreach ($files as $file) {
        try {
            $registry = Schema::compile(Dextrin::decode(readFileContents($file)), $registry);
        } catch (\Throwable $err) {
            throw new \RuntimeException("{$file}: " . describeError($err));
        }
    }
    return $registry;
}

/**
 * `dextrin conformance REQUEST ANSWER` -- this implementation's adapter
 * for the Dextrin Conformance Suite: reads the JSON request, answers every
 * case, writes the JSON answer. It fails only when the adapter itself
 * cannot work, never because a case did: a failed case is an answer, and
 * the suite judges it.
 *
 * @param list<string> $args
 */
function cmdConformance(array $args): void
{
    if (count($args) !== 2) {
        throw new \RuntimeException('usage: dextrin conformance REQUEST ANSWER');
    }
    [$request, $answer] = $args;
    $decoded = json_decode((string) file_get_contents($request), true, flags: JSON_THROW_ON_ERROR);
    file_put_contents($answer, json_encode(\JOetjen\Dextrin\Conformance::answer($decoded), JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));
}

function printUsageAndExit(?string $command): int
{
    fwrite(STDOUT, USAGE . "\n");
    return $command === null ? 0 : 1;
}

/**
 * Runs one subcommand, catching anything it throws (a bad `PATH`, a
 * `DXNError`, a schema violation, a plain usage error) and reporting
 * it uniformly -- every command's own body can just `throw` and let
 * this be the one place that turns that into a clean message and a
 * non-zero exit code, rather than each command repeating the same
 * try/catch shape.
 *
 * @param \Closure(): void $fn
 */
function run(\Closure $fn): int
{
    try {
        $fn();
        return 0;
    } catch (\Throwable $err) {
        fwrite(STDERR, describeError($err) . "\n");
        return 1;
    }
}

function describeError(\Throwable $err): string
{
    if ($err instanceof DXNError && $err->offset !== null) {
        $unit = $err->stage === 'binary' ? 'byte offset' : 'offset';
        return "{$err->getMessage()} (at {$unit} {$err->offset})";
    }
    return $err->getMessage();
}

/**
 * Hand-rolled, dependency-free argv parsing -- the CLI's own option
 * surface is small and fixed per subcommand, so a parser-generator
 * library would be an unneeded dependency for what a few `match`
 * arms already do plainly.
 *
 * @param list<string> $argv
 * @param list<string> $flagNames
 * @param list<string> $optionNames
 * @return array{positional: list<string>, flags: array<string, bool>, options: array<string, string>}
 */
function parseArgs(array $argv, array $flagNames = [], array $optionNames = []): array
{
    $positional = [];
    $flags = [];
    $options = [];

    $count = count($argv);
    for ($i = 0; $i < $count; $i++) {
        $arg = $argv[$i];
        $name = str_starts_with($arg, '--') ? substr($arg, 2) : null;
        if ($name !== null && in_array($name, $flagNames, true)) {
            $flags[$name] = true;
        } elseif ($name !== null && in_array($name, $optionNames, true)) {
            $i++;
            $options[$name] = $argv[$i] ?? throw new \RuntimeException("--{$name} requires a value");
        } else {
            $positional[] = $arg;
        }
    }
    return ['positional' => $positional, 'flags' => $flags, 'options' => $options];
}

function writeText(string $text, ?string $outPath): void
{
    if ($outPath !== null) {
        file_put_contents($outPath, $text);
    } else {
        fwrite(STDOUT, $text . "\n");
    }
}

function writeBinary(string $bytes, ?string $outPath): void
{
    if ($outPath !== null) {
        file_put_contents($outPath, $bytes);
    } else {
        fwrite(STDOUT, $bytes);
    }
}

function readFileContents(string $path): string
{
    $contents = file_get_contents($path);
    if ($contents === false) {
        throw new \RuntimeException("failed to read {$path}");
    }
    return $contents;
}

/** @param list<string> $argv */
function cmdDecode(array $argv): void
{
    ['positional' => $positional, 'options' => $options] = parseArgs($argv, optionNames: ['out']);
    if (count($positional) !== 1) {
        throw new \RuntimeException('usage: dextrin decode PATH [--out PATH]');
    }
    $value = Dextrin::decodeBinary(readFileContents($positional[0]));
    writeText(Dextrin::encode($value, pretty: true), $options['out'] ?? null);
}

/** @param list<string> $argv */
function cmdEncode(array $argv): void
{
    ['positional' => $positional, 'options' => $options] = parseArgs($argv, optionNames: ['out']);
    if (count($positional) !== 1) {
        throw new \RuntimeException('usage: dextrin encode PATH [--out PATH]');
    }
    $value = Dextrin::decode(readFileContents($positional[0]));
    writeBinary(Dextrin::encodeBinary($value), $options['out'] ?? null);
}

/** @param list<string> $argv */
function cmdFormat(array $argv): void
{
    ['positional' => $positional, 'flags' => $flags, 'options' => $options] =
        parseArgs($argv, flagNames: ['in-place'], optionNames: ['mode']);
    if (count($positional) !== 1) {
        throw new \RuntimeException('usage: dextrin format PATH [--mode pretty|condense] [--in-place]');
    }
    [$path] = $positional;
    $mode = $options['mode'] ?? 'pretty';
    if ($mode !== 'pretty' && $mode !== 'condense') {
        throw new \RuntimeException("unrecognized --mode \"{$mode}\" -- expected \"pretty\" or \"condense\"");
    }
    // Pretty lays the document out and keeps its comments; condensed
    // output is one line, which no comment fits on, so it reprints the
    // value.
    $doc = \JOetjen\Dextrin\Document::parse(readFileContents($path));
    $text = $mode === 'pretty' ? $doc->format() : Dextrin::encode($doc->toValue());
    // A file written in place ends with one newline, and so does printed
    // output, whether or not the formatted text kept the source's.
    $line = rtrim($text, "\n") . "\n";
    if ($flags['in-place'] ?? false) {
        file_put_contents($path, $line);
    } else {
        fwrite(STDOUT, $line);
    }
}

/** @param list<string> $argv */
function cmdValidate(array $argv): void
{
    ['positional' => $positional, 'options' => $options] =
        parseArgs($argv, optionNames: ['format', 'schema', 'as']);
    if (count($positional) !== 1) {
        throw new \RuntimeException('usage: dextrin validate PATH [--format text|binary] [--schema PATH --as NAME]');
    }
    [$path] = $positional;
    $format = detectFormat($path, $options['format'] ?? null);

    $registry = new Registry();
    if (isset($options['schema'])) {
        try {
            $schemaDoc = Dextrin::decode(readFileContents($options['schema']));
        } catch (\Throwable $err) {
            throw new \RuntimeException("failed to compile schema {$options['schema']}: " . describeError($err));
        }
        $registry = Schema::compile($schemaDoc, $registry);
    }

    try {
        $value = $format === 'binary'
            ? Dextrin::decodeBinary(readFileContents($path), $registry)
            : Dextrin::decode(readFileContents($path), $registry);
    } catch (\Throwable $err) {
        throw new \RuntimeException("{$path}: " . describeError($err));
    }

    $suffix = $format === 'binary' ? 'b' : '';
    if (!isset($options['as'])) {
        fwrite(STDOUT, "OK: {$path} is valid .dxn{$suffix}\n");
        return;
    }

    // Deliberately Schema::validateEncode, not Schema::validate:
    // `$value` has already gone through decode's own automatic,
    // registry-driven materialization -- validateEncode accepts any
    // shape (struct, materialized field map, or a real registered
    // class instance), which is what "does this decoded value satisfy
    // schema NAME" needs here.
    try {
        Schema::validateEncode($value, $registry, $options['as']);
    } catch (\Throwable $err) {
        throw new \RuntimeException("{$path} does not satisfy schema {$options['as']}: " . describeError($err));
    }
    fwrite(STDOUT, "OK: {$path} is valid .dxn{$suffix} and satisfies schema {$options['as']}\n");
}

function detectFormat(string $path, ?string $forced): string
{
    if ($forced === 'text' || $forced === 'binary') {
        return $forced;
    }
    return str_ends_with($path, '.dxnb') ? 'binary' : 'text';
}

exit(main(array_slice($argv, 1)));
